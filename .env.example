# Speedtest Logger - Environment Variables
# Copy this file to .env and fill in your details

# Your Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_token_here

# Optional: heartbeat-monitor ping URL. After each speedtest the backend pings it
# (or <url>/fail when the test errors). Leave unset to disable.
# HEARTBEAT_URL=http://personal-vps/heartbeat/ping/speedtest

# Optional: Override the API URL (used by the frontend)
# API_URL=http://backend:5000/api
